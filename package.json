{
  "name": "ui",
  "version": "2.5-dev",
  "private": true,
  "repository": "https://github.com/rancher/ui",
  "license": "Apache-2.0",
  "author": "Rancher Labs, Inc.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build && node ./scripts/copy-vue-assets.mjs",
    "build-static": "vite build --base ./ && node ./scripts/copy-vue-assets.mjs",
    "dev": "vite --host 0.0.0.0",
    "start": "vite --host 0.0.0.0",
    "test": "yarn test:unit && yarn test:browser && yarn build",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:browser": "bash ./scripts/test-terminal-audit-playwright.sh",
    "lint:js": "eslint --max-warnings 0 src",
    "lint:fix": "eslint --max-warnings 0 --fix src"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "vite": "5.4.21",
    "vue": "3.5.34"
  },
  "devDependencies": {
    "@eslint/js": "9.25.1",
    "eslint": "9.25.1",
    "eslint-plugin-vue": "9.33.0"
  }
}
